{
  "name": "Sports Medicine X-Ray Academy",
  "short_name": "X-Ray Academy",
  "description": "High-yield musculoskeletal radiograph interpretation for UCLA family medicine residents and sports medicine fellows.",
  "id": "/",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "orientation": "any",
  "background_color": "#F3F7FA",
  "theme_color": "#003B5C",
  "categories": ["education", "medical"],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard?source=pwa-shortcut",
      "icons": [{ "src": "/brand/pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Modules",
      "short_name": "Modules",
      "url": "/modules?source=pwa-shortcut",
      "icons": [{ "src": "/brand/pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Flashcards",
      "short_name": "Cards",
      "url": "/flashcards?source=pwa-shortcut",
      "icons": [{ "src": "/brand/pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/brand/app-icon-bone.svg",
      "sizes": "1024x1024",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/brand/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/pwa-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/brand/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
